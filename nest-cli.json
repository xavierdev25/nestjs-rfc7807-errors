{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/enterprise-demo",
  "sourceRoot": "apps/enterprise-demo/src",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/enterprise-demo/tsconfig.app.json",
    "deleteOutDir": true
  },
  "projects": {
    "enterprise-demo": {
      "type": "application",
      "root": "apps/enterprise-demo",
      "entryFile": "main",
      "sourceRoot": "apps/enterprise-demo/src",
      "compilerOptions": {
        "tsConfigPath": "apps/enterprise-demo/tsconfig.app.json"
      }
    },
    "rfc7807-errors": {
      "type": "library",
      "root": "libs/rfc7807-errors",
      "entryFile": "index",
      "sourceRoot": "libs/rfc7807-errors/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rfc7807-errors/tsconfig.json"
      }
    }
  }
}
