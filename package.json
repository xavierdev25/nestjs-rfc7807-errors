{
  "name": "nestjs-rfc7807-errors",
  "version": "0.0.1",
  "description": "NestJS monorepo: RFC 7807 Problem Details library & enterprise demo",
  "author": "Xavier Montaño",
  "private": true,
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter @xavierdev25/rfc7807-errors build",
    "build:app": "pnpm --filter @xavierdev25/enterprise-demo build",
    "format": "prettier --write \"{apps,libs}/**/src/**/*.ts\"",
    "start:dev": "pnpm --filter @xavierdev25/enterprise-demo start:dev",
    "lint": "eslint \"{apps,libs}/**/src/**/*.ts\" --fix",
    "test": "pnpm -r test",
    "test:lib": "pnpm --filter @xavierdev25/rfc7807-errors test",
    "test:app": "pnpm --filter @xavierdev25/enterprise-demo test",
    "test:cov": "pnpm -r test:cov",
    "test:e2e": "pnpm --filter @xavierdev25/enterprise-demo test:e2e"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "sql.js": "^1.14.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
