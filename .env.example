# ==============================================================================
# Enterprise Demo — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_NAME=enterprise-demo
APP_LOG_LEVEL=debug

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_demo
POSTGRES_USER=app_user
POSTGRES_PASSWORD=S3cur3P@ssw0rd!2026
POSTGRES_SSL=false

# Connection string (constructed from above, used by TypeORM/Prisma)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Testing Database ─────────────────────────────────────────────────────────
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=app_user
TEST_DB_PASSWORD=S3cur3P@ssw0rd!2026
TEST_DB_NAME=test_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=R3d1sP@ss2026
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ─── AWS / Floci (Local AWS Emulator) ────────────────────────────────────────
AWS_ENDPOINT_URL=http://floci:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Queues
SQS_DOMAIN_EVENTS_QUEUE=domain-events
SQS_DOMAIN_EVENTS_DLQ=domain-events-dlq
SQS_TRANSACTION_QUEUE=transactions
SQS_TRANSACTION_DLQ=transactions-dlq

# S3 Buckets
S3_DOCUMENTS_BUCKET=enterprise-documents
S3_AUDIT_BUCKET=enterprise-audit-logs

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── Observability ────────────────────────────────────────────────────────────
CORRELATION_ID_HEADER=X-Correlation-ID
LOG_MASK_FIELDS=password,ssn,creditCard,token,authorization
